# Copy this file to .env and fill in the values, then run:  docker compose up -d --build
# Never commit the real .env file.

# ---- Database (use letters and numbers only in the password) --------------------
POSTGRES_USER=portal
POSTGRES_PASSWORD=
POSTGRES_DB=portal

# ---- Security: generate each with  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32 bytes / 64 hex characters for per-organization secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
MULTI_COMPANY_ENABLED=false

# ---- Where users open the portal ---------------------------------------------------
WEB_PORT=8080
APP_URL=http://localhost:8080
# Set to true as soon as the portal is served over HTTPS (recommended for any real deployment)
COOKIE_SECURE=false

# ---- Branding shown in the app -------------------------------------------------------
APP_NAME=Your Company Portal
APP_TAGLINE=Workforce & Task Management
# Shows one-click demo logins on the sign-in page. Keep false for real use.
DEMO_MODE=false

# ---- Email (optional; needed for invitations and password reset) ----------------------
# See docs/EMAIL_AND_AI_SETUP.md
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- AI (optional; leave as "none" to keep AI features off) -----------------------------
# none | anthropic | openai_compatible     (see docs/EMAIL_AND_AI_SETUP.md)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_SMART=
AI_MONTHLY_BUDGET_USD=0
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
