generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now())
  tasks         Task[]
  taskTemplates TaskTemplate[]
  teams         Team[]
  users         User[]
}

model User {
  id              String              @id @default(uuid())
  email           String              @unique
  passwordHash    String
  name            String
  role            Role
  managerId       String?
  organizationId  String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?
  activityLogs    ActivityLog[]
  notifications   Notification[]
  reviewsReceived PerformanceReview[] @relation("Reviewee")
  reviewsGiven    PerformanceReview[] @relation("Reviewer")
  refreshTokens   RefreshToken[]
  assignedTasks   Task[]              @relation("TaskAssignee")
  createdTasks    Task[]              @relation("TaskCreator")
  taskAttachments TaskAttachment[]
  taskUpdates     TaskUpdate[]
  ledTeams        Team[]              @relation("TeamLead")
  memberships     TeamMember[]
  manager         User?               @relation("UserManager", fields: [managerId], references: [id])
  directReports   User[]              @relation("UserManager")
  organization    Organization        @relation(fields: [organizationId], references: [id])
}

model Team {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  teamLeadId     String
  tasks          Task[]
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamLead       User         @relation("TeamLead", fields: [teamLeadId], references: [id])
  members        TeamMember[]
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

model Task {
  id              String           @id @default(uuid())
  title           String
  description     String?
  createdById     String
  assignedToId    String
  teamId          String
  parentTaskId    String?
  status          TaskStatus       @default(NOT_STARTED)
  priority        TaskPriority     @default(MEDIUM)
  progressPercent Int              @default(0)
  estimatedHours  Float?
  actualHours     Float?           @default(0)
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  organizationId  String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  notifications   Notification[]
  recurrenceRule  RecurrenceRule?
  assignedTo      User             @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy       User             @relation("TaskCreator", fields: [createdById], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  parentTask      Task?            @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks        Task[]           @relation("SubTasks")
  team            Team             @relation(fields: [teamId], references: [id])
  attachments     TaskAttachment[]
  updates         TaskUpdate[]
}

model TaskUpdate {
  id              String   @id @default(uuid())
  taskId          String
  userId          String
  progressPercent Int
  comment         String?
  hoursLogged     Float?
  createdAt       DateTime @default(now())
  task            Task     @relation(fields: [taskId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
}

model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  uploadedById String
  fileUrl      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model RecurrenceRule {
  id        String              @id @default(uuid())
  taskId    String              @unique
  frequency RecurrenceFrequency
  interval  Int                 @default(1)
  endDate   DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  task      Task                @relation(fields: [taskId], references: [id])
}

model Notification {
  id     String   @id @default(uuid())
  userId String
  taskId String?
  type   String
  isRead Boolean  @default(false)
  sentAt DateTime @default(now())
  task   Task?    @relation(fields: [taskId], references: [id])
  user   User     @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PerformanceReview {
  id                 String   @id @default(uuid())
  employeeId         String
  reviewerId         String
  taskCompletionRate Float
  onTimeRate         Float
  rating             Int
  comments           String?
  periodStart        DateTime
  periodEnd          DateTime
  createdAt          DateTime @default(now())
  employee           User     @relation("Reviewee", fields: [employeeId], references: [id])
  reviewer           User     @relation("Reviewer", fields: [reviewerId], references: [id])
}

model TaskTemplate {
  id                   String       @id @default(uuid())
  titlePattern         String
  description          String?
  defaultPriority      TaskPriority @default(MEDIUM)
  defaultDurationHours Float?
  checklist            String[]
  organizationId       String
  createdAt            DateTime     @default(now())
  organization         Organization @relation(fields: [organizationId], references: [id])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  MANAGER
  TEAM_LEAD
  EMPLOYEE
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  ON_HOLD
  PENDING_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}
