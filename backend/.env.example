# Copy to .env for running the API directly on your machine (npm run dev).
# For Docker, use the .env.example in the project root instead.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://portal:YOUR_POSTGRES_PASSWORD@localhost:5432/portal
# Isolated test database for running npm test (must end with _test on localhost)
TEST_DATABASE_URL=postgresql://portal:YOUR_POSTGRES_PASSWORD@localhost:5432/portal_test

# Timezone default (UTC by default; can be configured per organization)
DEFAULT_TIMEZONE=UTC

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-1
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-2

# AES-256-GCM encryption key for per-organization secrets (32 bytes / 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Multi-company readiness flag (false by default; preserves single-company behavior)
MULTI_COMPANY_ENABLED=false

# Where the web app is served from (used for CORS and links in emails)
APP_URL=http://localhost:5173
# Extra allowed origins, comma separated (defaults to APP_URL)
# CORS_ORIGINS=http://localhost:5173,https://portal.example.com

# Optional - see docs/EMAIL_AND_AI_SETUP.md
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_FROM="Portal <no-reply@example.com>"
# AI_PROVIDER=none
